# 이 파일은 "양식"입니다. 실제 값이 들어가지 않습니다.
# 복사해서 .env 로 이름 바꾼 뒤, 거기에 진짜 토큰을 넣으세요.
#
#   copy .env.example .env
#
# .env 는 .gitignore 에 등록돼 있어 커밋되지 않습니다.

# 디스코드 봇 토큰 (개발자 포털 > 봇 > 토큰 초기화)
DISCORD_TOKEN=여기에_봇_토큰_붙여넣기

# 서버 ID (슬래시 명령어 즉시 반영용, 선택)
# 서버 우클릭 > 서버 ID 복사  (개발자 모드 켜야 보임)
# 여러 서버는 콤마로: GUILD_ID=123,456
GUILD_ID=
