# 이 파일은 "양식"이다. 실제 값은 들어있지 않다.
# 복사해서 이름을 .env 로 만든 뒤, 거기에 내 값을 채운다.
#
#   Windows:       copy .env.example .env
#   macOS / Linux: cp .env.example .env
#
# .env 는 .gitignore 에 들어있어 깃에 올라가지 않는다. 절대 공유하지 말 것.
# 각 값을 어디서 구하는지는 README.md 의 "3. 설정값 채우기" 참고.

# ── 필수 ──────────────────────────────────────────────

# 디스코드 봇 토큰 (봇의 비밀번호)
# 개발자 포털 > 내 앱 > Bot > Reset Token 으로 발급 (한 번만 보여준다)
DISCORD_TOKEN=여기에_봇_토큰_붙여넣기

# ── 권장 ──────────────────────────────────────────────

# 봇을 쓸 디스코드 서버 ID. 넣으면 슬래시 명령어가 즉시 반영된다 (비우면 최대 1시간).
# 디스코드 개발자 모드 켜기 > 서버 아이콘 우클릭 > "서버 ID 복사하기"
# 여러 서버는 콤마로: GUILD_ID=111111111111111111,222222222222222222
GUILD_ID=

# 대회 시작 후 자동 문제 수집이 끝내 실패했을 때 DM 을 받을 사람(운영자)의 사용자 ID.
# 비우면 서버 주인에게 보낸다.
# 디스코드 개발자 모드 켜기 > 내 프로필(이름) 우클릭 > "사용자 ID 복사하기"
ALERT_USER_ID=

# ── 선택 (보통 그대로 둔다) ────────────────────────────

# 대회/문제를 지울 때 대화·첨부·플래그를 ZIP 으로 백업할지. 1=백업(기본), 0=끔
BACKUP_ENABLED=1

# 내 PC(사설 IP)에 띄운 CTFd 로 시험할 때만 앞의 # 을 지워 켠다. 실제 운영에선 꺼둘 것 (보안).
# ALLOW_PRIVATE_TARGETS=1

# DB·백업을 저장할 폴더 (Python 으로 직접 실행할 때만). 안 적으면 프로젝트 폴더.
# Docker 는 /data 로 고정돼 있으니 Docker 에서는 이 줄을 켜지 말 것.
# DATA_DIR=C:\ctfbot-data
